# Copy this file to ".env" and edit it. Never commit ".env".

# OPTIONAL. A GitHub personal access token raises the API limit from
# 60 to 5,000 requests per hour. A token with NO scopes is enough, because
# this app only reads public data. Leave empty to run without a token.
GITHUB_TOKEN=

# Backend settings (defaults shown)
GITHUB_API_URL=https://api.github.com
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=2
CACHE_TTL_SECONDS=300
LANGUAGE_REPO_LIMIT=30
LOG_LEVEL=INFO

# Dashboard setting: where the Streamlit app finds the FastAPI backend.
BACKEND_URL=http://127.0.0.1:8000
